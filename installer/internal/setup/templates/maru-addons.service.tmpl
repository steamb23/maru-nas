# Written by maru install.sh
[Unit]
Description=Maru NAS addon backend sync
# {{.AddonSyncName}}.path starts this once per request; never stop starting it.
StartLimitIntervalSec=0

[Service]
# Started by {{.AddonSyncName}}.path. Enables, disables and restarts addon backend units to match
# the backends maru wants ({{.AddonBackendsFile}}); it never reads or runs package files.
# This is a root-owned copy of the installer, not the one in the repository.
Type=oneshot
ExecStart={{.UpgradeInstallerDst}} --addon-sync
TimeoutStartSec={{.AddonSyncTimeout}}
# Keeps root's file capabilities: it reads maru's 0600 desired-state file and deletes
# the request in maru's state directory. It drives the service manager, so this
# sandbox only limits mistakes, not what root can ask systemd to do.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-{{.AddonSyncDir}} -{{.StateDir}}
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
