# Written by maru install.sh
[Unit]
Description=Maru NAS dashboard for openmediavault
{{if .AllowNonLoopback}}Wants=network-online.target
After=network-online.target{{else}}After=network.target{{end}}{{if .Helper}}
Wants={{.HelperName}}.socket
After={{.HelperName}}.socket{{end}}

[Service]
Type=simple
User={{.User}}
Group={{.Group}}
EnvironmentFile={{.EnvFile}}
ExecStart={{.BinDst}}
Restart=on-failure
RestartSec=5

# Per-user preferences (STATE_DIRECTORY is passed to maru)
StateDirectory={{.Service}}
# Unix socket directory. Preserve keeps the same directory across restarts so a
# container bind mount of {{.RuntimeDir}} keeps working.
RuntimeDirectory={{.Service}}
RuntimeDirectoryPreserve=yes
{{- if .AddonBackends}}

# Host sockets of addon backends. {{.AddonHostDir}}/<id> is bound into that package's
# backend unit, so this user must not be able to replace <id> or anything above it:
# the directory is root's (created here as root, before the sandbox is set up) and
# each backend's socket unit creates <id> for this user. systemd sets up the mount
# namespace for the "+" command too, so the path is optional ("-"); it exists by the
# time ExecStart's namespace is set up.
ExecStartPre=+/usr/bin/install -d -o root -g root -m 0755 {{.AddonHostDir}}
ReadWritePaths=-{{.AddonHostDir}}
{{- end}}

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices=yes would hide /dev/disk/by-label (filesystem labels); deny device access instead.
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
