# Written by onmaru install.sh
[Unit]
Description=Onmaru privileged helper socket

[Socket]
ListenStream={{.HelperSocket}}
# Only the onmaru service user can connect (the helper also checks the peer uid).
SocketUser={{.User}}
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
