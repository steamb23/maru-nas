# Written by maru install.sh
[Unit]
Description=Maru NAS addon backend socket %i ({{.Tier.Label}})

[Socket]
# maru connects here; the first connection starts {{.Tier.Prefix}}@%i.service (the same name).
ListenStream={{.AddonSocketDir}}/%i.sock
# Only the maru service user can connect.
SocketUser={{.User}}
SocketGroup={{.Group}}
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes
# The host socket directory that the backend service binds. root creates it, so the
# maru service user can only write inside <id>, never replace <id> itself.
ExecStartPre=/usr/bin/install -d -o root -g root -m 0755 {{.AddonHostDir}}
ExecStartPre=/usr/bin/install -d -o {{.User}} -g {{.Group}} -m 0755 {{.AddonHostDir}}/%i

[Install]
WantedBy=sockets.target
