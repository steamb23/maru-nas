# Written by maru install.sh
[Unit]
Description=Onmaru dashboard for openmediavault
After=network.target
Wants=maru-helper.socket
After=maru-helper.socket

[Service]
Type=simple
User=maru
Group=nogroup
EnvironmentFile=/etc/default/maru
ExecStart=/usr/local/bin/maru
Restart=on-failure
RestartSec=5

# Per-user preferences (STATE_DIRECTORY is passed to maru)
StateDirectory=maru
# Unix socket directory. Preserve keeps the same directory across restarts so a
# container bind mount of /run/maru keeps working.
RuntimeDirectory=maru
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices=yes would hide /dev/disk/by-label (filesystem labels); deny device access instead.
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
