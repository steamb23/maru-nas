# Written by onmaru install.sh
[Unit]
Description=Onmaru privileged helper
Requires=onmaru-helper.socket
After=onmaru-helper.socket

[Service]
Type=simple
EnvironmentFile=/etc/default/onmaru-helper
ExecStart=/usr/local/bin/onmaru-helper

# Runs as root, but may only drop privileges to a user (SETUID/SETGID) and stop its own
# workers (KILL). Add capabilities here only together with a new root operation.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL
NoNewPrivileges=yes
ProtectSystem=strict
# User-scope file operations write on data disks and in home directories.
ReadWritePaths=-/srv -/home
# The root operation upgrade.apply writes dashboard upgrade requests here (onmaru-upgrade.path watches it).
RuntimeDirectory=onmaru-upgrade
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
