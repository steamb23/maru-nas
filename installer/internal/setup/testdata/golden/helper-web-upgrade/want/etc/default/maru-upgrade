# Upgrading from the dashboard (maru-upgrade.service). Written by install.sh; re-run it to change them.
# The service runs git and the build as the repository owner, then the new installer as root.
# Repository to build from (the checkout install.sh ran from).
MARU_UPGRADE_REPO=/repo
# Account that runs git and the build: the repository owner, never root.
MARU_UPGRADE_USER=alice
# PATH for git, Go, Node.js and make when building as that account.
MARU_UPGRADE_PATH=/usr/bin:/usr/local/bin:/bin
