# Written by maru install.sh
[Unit]
Description=Onmaru dashboard upgrade requests

[Path]
# A check request that maru leaves in its state directory, or an upgrade request
# from the privileged helper (root operation upgrade.apply).
PathExists=/var/lib/maru/upgrade-check.json
PathExists=/run/maru-upgrade/apply.json
Unit=maru-upgrade.service

[Install]
WantedBy=paths.target
