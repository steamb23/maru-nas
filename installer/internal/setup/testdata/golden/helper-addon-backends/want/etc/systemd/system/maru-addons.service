# Written by maru install.sh
[Unit]
Description=Maru NAS addon backend sync
# maru-addons.path starts this once per request; never stop starting it.
StartLimitIntervalSec=0

[Service]
# Started by maru-addons.path. Enables, disables and restarts addon backend units to match
# the backends maru wants (/var/lib/maru/addon-backends.json); it never reads or runs package files.
# This is a root-owned copy of the installer, not the one in the repository.
Type=oneshot
ExecStart=/usr/local/lib/maru/maru-install --addon-sync
TimeoutStartSec=10min
# Keeps root's file capabilities: it reads maru's 0600 desired-state file and deletes
# the request in maru's state directory. It drives the service manager, so this
# sandbox only limits mistakes, not what root can ask systemd to do.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/maru-addons -/var/lib/maru
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
