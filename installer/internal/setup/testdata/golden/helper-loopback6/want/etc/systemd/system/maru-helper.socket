# Written by maru install.sh
[Unit]
Description=Onmaru privileged helper socket

[Socket]
ListenStream=/run/maru-helper/helper.sock
# Only the maru service user can connect (the helper also checks the peer uid).
SocketUser=svc_maru
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
